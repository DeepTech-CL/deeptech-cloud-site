# Copy to .env.local for local development. Nothing here is secret (NEXT_PUBLIC_* is embedded in the static bundle).

# "" for the custom domain (https://deeptechcloud.online); "/<repo-name>" for https://<user>.github.io/<repo-name>
NEXT_PUBLIC_BASE_PATH=

# Canonical site URL used for metadata / Open Graph.
NEXT_PUBLIC_SITE_URL=https://deeptechcloud.online
